{
  "name": "@pdflover/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bunx tsc",
    "start": "bun dist/main.js",
    "typecheck": "bunx tsc --noEmit",
    "test": "vitest run --dir src",
    "lint": "bunx tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/multipart": "9.3.0",
    "@pdflover/shared": "workspace:*",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
