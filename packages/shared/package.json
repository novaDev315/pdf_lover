{
  "name": "@pdflover/shared",
  "version": "0.1.0",
  "description": "Shared types, constants, and utilities for PDFLover",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx tsc",
    "dev": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "lint": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "test": "vitest run --dir src/__tests__",
    "test:watch": "vitest --dir src/__tests__",
    "test:coverage": "vitest run --dir src/__tests__ --coverage"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
