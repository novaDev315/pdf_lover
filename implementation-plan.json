{
  "project": "PDFLover",
  "version": "1.0.0",
  "architecture": "local-first",
  "execution_strategy": {
    "approach": "parallel-first",
    "phases": 4,
    "estimated_duration": "2-3 weeks",
    "parallelization_level": "high"
  },

  "technical_decisions": {
    "runtime": "bun",
    "monorepo": "turborepo",
    "frontend": {
      "framework": "react@19",
      "bundler": "vite@6",
      "ui": "shadcn/ui",
      "styling": "tailwindcss@4",
      "state": "zustand",
      "routing": "tanstack-router"
    },
    "pdf_processing": {
      "rendering": "pdfjs-dist",
      "manipulation": "pdf-lib",
      "ocr": "@tesseract.js/tesseract",
      "html_to_pdf": "html2pdf.js"
    },
    "ai": {
      "local": "@xenova/transformers",
      "webgpu": "@webgpu/webgpu",
      "cloud": "openrouter-api-client"
    },
    "storage": {
      "indexeddb": "dexie",
      "cache": "workbox"
    },
    "backend": {
      "framework": "nestjs",
      "orm": "typeorm",
      "database": "postgresql",
      "cache": "redis"
    }
  },

